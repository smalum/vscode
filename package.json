{
  "name": "smalum",
  "displayName": "Smalum Preview",
  "description": "Превью PlantUML, Mermaid, DFD, BPMN, Infra, IDEF, SQL→ER и docker-compose.yml (UML deployment) в Markdown и файлах .sm / .puml / .yml. Раскладка с оверлеем — как на smalum.io.",
  "version": "0.2.44",
  "private": true,
  "publisher": "smalum",
  "license": "MIT",
  "homepage": "https://smalum.io",
  "bugs": {
    "url": "https://smalum.io"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "smalum",
    "plantuml",
    "mermaid",
    "bpmn",
    "dfd",
    "infra",
    "idef",
    "idef0",
    "c4",
    "docker-compose",
    "markdown"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:smalum",
    "onLanguage:plantuml",
    "onLanguage:puml",
    "onLanguage:plantuml2",
    "onLanguage:yaml",
    "onLanguage:dockercompose"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./preview.css"
    ],
    "markdown.previewScripts": [
      "./out/preview.js"
    ],
    "languages": [
      {
        "id": "smalum",
        "aliases": [
          "Smalum",
          "sm"
        ],
        "extensions": [
          ".sm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "puml"
        ],
        "extensions": [
          ".puml",
          ".plantuml"
        ]
      }
    ],
    "commands": [
      {
        "command": "smalum.preview",
        "title": "Smalum: Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "smalum.openInApp",
        "title": "Smalum: Открыть в Smalum",
        "icon": "$(link-external)"
      },
      {
        "command": "smalum.copySvg",
        "title": "Smalum: Копировать SVG"
      },
      {
        "command": "smalum.exportSvg",
        "title": "Smalum: Экспорт SVG…"
      },
      {
        "command": "smalum.copySource",
        "title": "Smalum: Копировать исходник"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "smalum.preview",
          "when": "resourceExtname == .sm || resourceExtname == .puml || resourceExtname == .plantuml || resourceExtname == .yml || resourceExtname == .yaml || editorLangId == markdown || editorLangId == smalum || editorLangId == plantuml || editorLangId == puml || editorLangId == yaml || editorLangId == dockercompose",
          "group": "navigation"
        },
        {
          "command": "smalum.openInApp",
          "when": "resourceExtname == .sm || resourceExtname == .puml || resourceExtname == .plantuml || resourceExtname == .yml || resourceExtname == .yaml || editorLangId == markdown || editorLangId == smalum || editorLangId == plantuml || editorLangId == puml || editorLangId == yaml || editorLangId == dockercompose",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --baseContentUrl https://github.com/smalum/vscode/raw/main/ --baseImagesUrl https://github.com/smalum/vscode/raw/main/"
  },
  "icon": "icon.png",
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0"
  }
}
