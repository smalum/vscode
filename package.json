{
  "name": "smalum",
  "displayName": "Smalum Preview",
  "description": "Превью PlantUML, Mermaid, DFD, BPMN и Infra (C4, Struct, SQL→ER) в Markdown и файлах .sm / .puml. Раскладка с оверлеем — как на smalum.io.",
  "version": "0.2.34",
  "private": true,
  "publisher": "smalum",
  "license": "MIT",
  "homepage": "https://smalum.ru",
  "bugs": {
    "url": "https://smalum.ru"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "smalum",
    "plantuml",
    "mermaid",
    "bpmn",
    "dfd",
    "infra",
    "c4",
    "markdown"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:smalum",
    "onLanguage:plantuml",
    "onLanguage:puml",
    "onLanguage:plantuml2"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./preview.css"
    ],
    "markdown.previewScripts": [
      "./out/preview.js"
    ],
    "languages": [
      {
        "id": "smalum",
        "aliases": [
          "Smalum",
          "sm"
        ],
        "extensions": [
          ".sm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "puml"
        ],
        "extensions": [
          ".puml",
          ".plantuml"
        ]
      }
    ],
    "commands": [
      {
        "command": "smalum.preview",
        "title": "Smalum: Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "smalum.openInApp",
        "title": "Smalum: \u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0432 Smalum",
        "icon": "$(link-external)"
      },
      {
        "command": "smalum.copySvg",
        "title": "Smalum: \u041a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c SVG"
      },
      {
        "command": "smalum.exportSvg",
        "title": "Smalum: \u042d\u043a\u0441\u043f\u043e\u0440\u0442 SVG\u2026"
      },
      {
        "command": "smalum.copySource",
        "title": "Smalum: \u041a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0441\u0445\u043e\u0434\u043d\u0438\u043a"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "smalum.preview",
          "when": "resourceExtname == .sm || resourceExtname == .puml || resourceExtname == .plantuml || editorLangId == markdown || editorLangId == smalum || editorLangId == plantuml || editorLangId == puml",
          "group": "navigation"
        },
        {
          "command": "smalum.openInApp",
          "when": "resourceExtname == .sm || resourceExtname == .puml || resourceExtname == .plantuml || editorLangId == markdown || editorLangId == smalum || editorLangId == plantuml || editorLangId == puml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "icon": "icon.png",
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0"
  }
}
