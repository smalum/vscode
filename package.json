{
  "name": "smalum",
  "displayName": "Smalum Preview",
  "description": "\u041f\u0440\u0435\u0432\u044c\u044e PlantUML, Mermaid, DFD \u0438 BPMN (C4, Struct, SQL\u2192ER) \u0432 Markdown \u0438 \u0444\u0430\u0439\u043b\u0430\u0445 .sm / .puml. \u0420\u0430\u0441\u043a\u043b\u0430\u0434\u043a\u0430 \u0441 \u043e\u0432\u0435\u0440\u043b\u0435\u0435\u043c \u2014 \u043a\u0430\u043a \u043d\u0430 smalum.io.",
  "version": "0.2.30",
  "private": true,
  "publisher": "smalum",
  "license": "MIT",
  "homepage": "https://smalum.io",
  "repository": {
    "type": "git",
    "url": "https://git.mtk.red/khramtsovsky/smalum.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "smalum",
    "plantuml",
    "mermaid",
    "bpmn",
    "dfd",
    "c4",
    "markdown"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:smalum",
    "onLanguage:plantuml",
    "onLanguage:puml",
    "onLanguage:plantuml2"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./preview.css"
    ],
    "markdown.previewScripts": [
      "./out/preview.js"
    ],
    "languages": [
      {
        "id": "smalum",
        "aliases": [
          "Smalum",
          "sm"
        ],
        "extensions": [
          ".sm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "puml"
        ],
        "extensions": [
          ".puml",
          ".plantuml"
        ]
      }
    ],
    "commands": [
      {
        "command": "smalum.preview",
        "title": "Smalum: Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "smalum.openInApp",
        "title": "Smalum: \u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0432 Smalum",
        "icon": "$(link-external)"
      },
      {
        "command": "smalum.copySource",
        "title": "Smalum: \u041a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0441\u0445\u043e\u0434\u043d\u0438\u043a"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "smalum.preview",
          "when": "resourceExtname == .sm || resourceExtname == .puml || resourceExtname == .plantuml || editorLangId == markdown || editorLangId == smalum || editorLangId == plantuml || editorLangId == puml",
          "group": "navigation"
        },
        {
          "command": "smalum.openInApp",
          "when": "resourceExtname == .sm || resourceExtname == .puml || resourceExtname == .plantuml || editorLangId == markdown || editorLangId == smalum || editorLangId == plantuml || editorLangId == puml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "icon": "icon.png",
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0"
  }
}
